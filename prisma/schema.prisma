generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  email String @db.VarChar(255) @unique
  enrollments Enrollments[]
}

model Plans {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(50)
  price Decimal @db.Decimal(10,2)
  duration_months Int
  description String @db.Text
  has_phys_eval Boolean 
  has_nutritionist Boolean 
  has_app_access Boolean 
  modalities PlansOnModalities[]
  enrollments Enrollments[]
}

enum Objective {
  EMAGRECIMENTO
  HIPERTROFIA
  RELAXAMENTO
}

model Modalities {
  id Int @id @default(autoincrement())
  name String @db.VarChar(50)
  description String @db.Text
  objective Objective
  plans PlansOnModalities[]
  schedules Schedules[]
  experimental_leads Experimental_Leads[]
}

model PlansOnModalities {
  plan Plans @relation(fields: [planId], references: [id])
  planId Int
  modality Modalities @relation(fields: [modalityId], references: [id])
  modalityId Int
  @@id([planId, modalityId])
}

enum Day {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

model Schedules {
  id   Int    @id @default(autoincrement())
  modality Modalities @relation(fields: [modalityId], references: [id])
  modalityId Int
  day_of_week Day 
  max_capacity Int
  start_time String @db.VarChar(5)
  end_time String @db.VarChar(5)
  needs_booking Boolean 
  booking Booking[]
}

model Team {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(50)
  qualification String @db.VarChar(50)
  photo_url String @db.VarChar(255)
}

model Enrollments {
  id   Int    @id @default(autoincrement())
  full_name String @db.VarChar(80)
  cpf  String   @db.VarChar(14)
  email String? @db.VarChar(255)
  phone String? @db.VarChar(11)
  birthdate DateTime? @db.Date
  plan Plans @relation(fields: [planId], references: [id])
  planId Int
  user User @relation(fields: [userId], references: [id])
  userId Int
  preferred_time DateTime @db.Time
  zip_code String @db.VarChar(9)
  street String @db.VarChar(255)
  number String @db.VarChar(10)
  complement String? @db.VarChar(60)
  neighborhood String? @db.VarChar(80)
  city String? @db.VarChar(80)
  state String? @db.VarChar(2)
  terms_accepted Boolean
  created_at DateTime @default(now())
  booking Booking[]
}

enum Status {
  PENDENTE
  CONTATADO
  REALIZADO
}

model Experimental_Leads {
  id Int @id @default(autoincrement())
  name String @db.VarChar(50)
  contact String @db.VarChar(50)
  modality Modalities @relation(fields: [modalityId], references: [id])
  modalityId Int
  status Status @default(PENDENTE)
}

enum StatusBooking {
  PENDENTE
  CONFIRMADO
  CANCELADO
  FALTOU
}

model Booking {
  id Int @id @default(autoincrement())
  booking_date DateTime @db.Date
  created_at DateTime @default(now())
  status StatusBooking @default(PENDENTE)
  enrollment Enrollments @relation(fields: [enrollmentId], references: [id])
  enrollmentId Int
  schedule Schedules @relation(fields: [scheduleId], references: [id])
  scheduleId Int
}