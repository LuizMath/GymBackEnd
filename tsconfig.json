{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler"
  },
  "exclude": ["node_modules", "prisma.config.ts"]
}
